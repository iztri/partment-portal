# Copy to .env for local dev (see run.sh). In production these are set in the
# Render dashboard, not committed.

# Local dev: leave DATABASE_BACKEND unset to use SQLite (local_dev.db).
# Set to "supabase" to test the Supabase path locally.
# DATABASE_BACKEND=supabase

# Session signing key. Any long random string.
FLASK_SECRET=change-me-to-a-long-random-string

# Supabase (production). SUPABASE_KEY must be the service_role key.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_KEY=your-service-role-key

# First-run admin seed (only used when the users table is empty).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
